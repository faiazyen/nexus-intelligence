# --- Core services ---
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
QDRANT_URL=http://localhost:6333

# --- LLM (all calls route through OpenRouter — one key, one SDK) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxx

# Model routing overrides (optional — defaults verified against
# OpenRouter's live /api/v1/models catalog; re-verify before trusting
# these if it's been a while, that catalog moves fast)
NEXUS_LLM_CLASSIFIER=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
NEXUS_LLM_CLASSIFIER_FALLBACK=deepseek/deepseek-v4-flash
NEXUS_LLM_OUTREACH=moonshotai/kimi-k2-thinking
NEXUS_LLM_BRAIN=moonshotai/kimi-k2-thinking
NEXUS_LLM_FALLBACK=anthropic/claude-opus-4.8

# Hard daily spend limit in USD before routing drops to free-tier/rule-based only
NEXUS_DAILY_LLM_LIMIT=0.25

# Skip the anthropic/* fallback slug entirely (still via OpenRouter, not a
# separate key) — for pure non-Claude beta cost testing
NEXUS_DISABLE_CLAUDE=false

# --- Data sources (optional in dev; agents degrade gracefully) ---
APOLLO_API_KEY=
NEWSAPI_KEY=
CRUNCHBASE_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
